{
  "name": "frog-balance",
  "version": "0.0.0",
  "description": "Arabic educational math game — Mizan Dofdou (Frog Balance).",
  "scripts": {
    "dev": "vite --host --port 5173",
    "build": "tsc --noEmit && vite build && node --import tsx tools/size-report.ts",
    "preview": "vite preview --host --port 4173",
    "lint": "eslint . && prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "validate:content": "node --import tsx tools/validate-content.ts",
    "check": "npm run lint && npm run test && npm run validate:content && npm run build && npm run test:e2e",
    "validate:cross-check": "python3 tools/build_levels.py --check --json | node --import tsx tools/cross-check-levels.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohamedalaa1150/frog-balance.git"
  },
  "type": "module",
  "bugs": {
    "url": "https://github.com/mohamedalaa1150/frog-balance/issues"
  },
  "homepage": "https://github.com/mohamedalaa1150/frog-balance#readme",
  "dependencies": {
    "@fontsource/baloo-bhaijaan-2": "5.3.0",
    "phaser": "3.90.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  }
}
